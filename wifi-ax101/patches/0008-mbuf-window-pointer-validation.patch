 /*
+ * Exercise malformed mblk windows without dereferencing an invalid address.
+ * The helper validates the address ordering even for a zero-byte no-op;
+ * this keeps the test deterministic and makes the negative control safe.
+ */
+static void
+check_shift_rejects_bad_window(mblk_t *m, unsigned char *rptr,
+    unsigned char *wptr, const char *what)
+{
+	unsigned char *saved_rptr = m->b_rptr;
+	unsigned char *saved_wptr = m->b_wptr;
+	unsigned char snapshot[16];
+	long frees_before = iwx_test_frees;
+
+	memcpy(snapshot, DB_BASE(m), sizeof (snapshot));
+	m->b_rptr = rptr;
+	m->b_wptr = wptr;
+	CHECK(iwx_m_shift_right(m, 0, 0) == B_FALSE, what);
+	CHECK(m->b_rptr == rptr && m->b_wptr == wptr,
+	    "bad-window rejection must preserve pointer values");
+	CHECK(memcmp(DB_BASE(m), snapshot, sizeof (snapshot)) == 0,
+	    "bad-window rejection must preserve backing bytes");
+	CHECK(iwx_test_frees == frees_before,
+	    "bad-window rejection must preserve caller ownership");
+	m->b_rptr = saved_rptr;
+	m->b_wptr = saved_wptr;
+}
+
+static void
+test_shift_right_p0_null_and_edge_cases(void)
+{
+	mblk_t *m = iwx_m_alloc(64);
+	dblk_t *saved_datap;
+	unsigned char *base, *saved_base, *saved_limit, *saved_rptr, *saved_wptr;
+	unsigned char snapshot[32];
+	long frees_before;
+
+	CHECK(iwx_m_shift_right(NULL, 1, 1) == B_FALSE,
+	    "NULL mblk must be rejected before dereference");
+	CHECK(m != NULL, "alloc NULL/edge test");
+	if (m == NULL)
+		return;
+	saved_datap = m->b_datap;
+	base = DB_BASE(m);
+	saved_base = DB_BASE(m);
+	saved_limit = DB_LIM(m);
+	saved_rptr = m->b_rptr;
+	saved_wptr = m->b_wptr;
+	memset(base, 0x5A, sizeof (snapshot));
+	memcpy(snapshot, base, sizeof (snapshot));
+	frees_before = iwx_test_frees;
+
+	m->b_datap = NULL;
+	CHECK(iwx_m_shift_right(m, 1, 1) == B_FALSE,
+	    "NULL b_datap must be rejected");
+	CHECK(m->b_datap == NULL, "NULL b_datap must remain unchanged on refusal");
+	m->b_datap = saved_datap;
+
+	DB_BASE(m) = NULL;
+	CHECK(iwx_m_shift_right(m, 1, 1) == B_FALSE,
+	    "NULL DB_BASE must be rejected");
+	CHECK(DB_BASE(m) == NULL, "NULL DB_BASE must remain unchanged on refusal");
+	DB_BASE(m) = saved_base;
+
+	DB_LIM(m) = NULL;
+	CHECK(iwx_m_shift_right(m, 1, 1) == B_FALSE,
+	    "NULL DB_LIM must be rejected");
+	CHECK(DB_LIM(m) == NULL, "NULL DB_LIM must remain unchanged on refusal");
+	DB_LIM(m) = saved_limit;
+
+	m->b_rptr = NULL;
+	CHECK(iwx_m_shift_right(m, 1, 1) == B_FALSE,
+	    "NULL b_rptr must be rejected");
+	CHECK(m->b_rptr == NULL, "NULL b_rptr must remain unchanged on refusal");
+	m->b_rptr = saved_rptr;
+
+	m->b_wptr = NULL;
+	CHECK(iwx_m_shift_right(m, 1, 1) == B_FALSE,
+	    "NULL b_wptr must be rejected");
+	CHECK(m->b_wptr == NULL, "NULL b_wptr must remain unchanged on refusal");
+	m->b_wptr = saved_wptr;
+
+	CHECK(memcmp(base, snapshot, sizeof (snapshot)) == 0,
+	    "NULL metadata refusals must preserve backing bytes");
+	CHECK(iwx_test_frees == frees_before,
+	    "NULL metadata refusals must preserve caller ownership");
+
+	/* Exact fit: header plus pad fills the available destination window. */
+	DB_LIM(m) = base + 26;
+	m->b_rptr = base;
+	m->b_wptr = base + 26;
+	for (size_t i = 0; i < 26; i++)
+		base[i] = (unsigned char)(i + 1);
+	CHECK(iwx_m_shift_right(m, 24, 2) == B_TRUE,
+	    "exact-fit header and pad must be accepted");
+	CHECK(m->b_wptr == base + 26,
+	    "exact-fit shift must not extend the received window");
+	CHECK(base[2] == 1 && base[25] == 24,
+	    "exact-fit shift must preserve all header bytes");
+
+	/* One byte short in capacity and in the readable window are distinct. */
+	DB_LIM(m) = base + 25;
+	m->b_rptr = base;
+	m->b_wptr = base + 25;
+	memset(base, 0x6B, sizeof (snapshot));
+	memcpy(snapshot, base, sizeof (snapshot));
+	CHECK(iwx_m_shift_right(m, 24, 2) == B_FALSE,
+	    "one-byte-short capacity must be rejected");
+	CHECK(DB_LIM(m) == base + 25 && m->b_rptr == base &&
+	    m->b_wptr == base + 25,
+	    "capacity refusal must preserve metadata");
+	CHECK(memcmp(base, snapshot, sizeof (snapshot)) == 0,
+	    "capacity refusal must preserve bytes");
+
+	DB_LIM(m) = base + 26;
+	m->b_rptr = base;
+	m->b_wptr = base + 25;
+	memcpy(snapshot, base, sizeof (snapshot));
+	CHECK(iwx_m_shift_right(m, 24, 2) == B_FALSE,
+	    "one-byte-short readable pad must be rejected");
+	CHECK(m->b_rptr == base && m->b_wptr == base + 25,
+	    "readable-window refusal must preserve metadata");
+	CHECK(memcmp(base, snapshot, sizeof (snapshot)) == 0,
+	    "readable-window refusal must preserve bytes");
+
+	m->b_wptr = base + 26;
+	CHECK(iwx_m_shift_right(m, SIZE_MAX, 1) == B_FALSE,
+	    "SIZE_MAX source length must be rejected");
+	CHECK(iwx_m_shift_right(m, 1, SIZE_MAX) == B_FALSE,
+	    "SIZE_MAX padding must be rejected without addition overflow");
+	CHECK(iwx_m_shift_right(m, SIZE_MAX - 1, SIZE_MAX) == B_FALSE,
+	    "combined extreme lengths must be rejected without overflow");
+
+	m->b_wptr = base + 8;
+	CHECK(iwx_m_shift_right(m, 8, 0) == B_TRUE,
+	    "zero padding with exact readable length is a valid no-op");
+	CHECK(iwx_m_shift_right(m, 9, 0) == B_FALSE,
+	    "zero padding must still reject a too-long source");
+	CHECK(iwx_m_shift_right(m, SIZE_MAX, 0) == B_FALSE,
+	    "zero padding must reject SIZE_MAX source length");
+
+	CHECK(iwx_test_frees == frees_before,
+	    "rejected edge cases must preserve caller ownership");
+	m->b_datap = saved_datap;
+	DB_BASE(m) = saved_base;
+	DB_LIM(m) = saved_limit;
+	m->b_rptr = saved_rptr;
+	m->b_wptr = saved_wptr;
+	iwx_m_free(m);
+	CHECK(iwx_test_frees == frees_before + 1,
+	    "metadata must be restored before exactly one caller free");
+}
+
+/*
+ * Exercise malformed windows with real pointers from the same allocation.
+ * No integer-derived or out-of-object pointer is ever manufactured.
+ */
+static void
+test_shift_right_p0_malformed_windows(void)
+{
+	mblk_t *m = iwx_m_alloc(64);
+	unsigned char *base, *saved_base, *saved_limit;
+
+	CHECK(m != NULL, "alloc malformed-window test");
+	if (m == NULL)
+		return;
+	base = DB_BASE(m);
+	saved_base = DB_BASE(m);
+	saved_limit = DB_LIM(m);
+	memset(base, 0xA5, 16);
+
+	DB_BASE(m) = base + 1;
+	check_shift_rejects_bad_window(m,
+	    base, base + 8, "read pointer below db_base must be rejected");
+	DB_BASE(m) = saved_base;
+
+	DB_LIM(m) = base + 16;
+	check_shift_rejects_bad_window(m,
+	    base + 17, base + 17, "read pointer above db_lim must be rejected");
+	DB_LIM(m) = saved_limit;
+
+	check_shift_rejects_bad_window(m,
+	    base + 16, base + 8, "write pointer before read pointer must be rejected");
+
+	DB_LIM(m) = base + 16;
+	check_shift_rejects_bad_window(m,
+	    base, base + 17, "write pointer beyond db_lim must be rejected");
+	DB_LIM(m) = saved_limit;
+
+	DB_BASE(m) = base + 16;
+	DB_LIM(m) = base + 8;
+	check_shift_rejects_bad_window(m,
+	    base + 16, base + 16, "db_lim below db_base must be rejected");
+	DB_BASE(m) = saved_base;
+	DB_LIM(m) = saved_limit;
+
+	iwx_m_free(m);
+}
+
+/*
  * if_iwx.c:10882 / :10927 -- "(struct iwx_rx_packet *)(m0->m_data + offset)"
  * walks several firmware responses packed into one RX buffer, where offset
