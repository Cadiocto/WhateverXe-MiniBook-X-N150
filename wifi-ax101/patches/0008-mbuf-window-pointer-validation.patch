 /*
+ * Exercise malformed mblk windows without dereferencing an invalid address.
+ * The helper validates the address ordering even for a zero-byte no-op;
+ * this keeps the test deterministic and makes the negative control safe.
+ */
+static void
+check_shift_rejects_bad_window(mblk_t *m, unsigned char *rptr,
+    unsigned char *wptr, const char *what)
+{
+	unsigned char *saved_rptr = m->b_rptr;
+	unsigned char *saved_wptr = m->b_wptr;
+	unsigned char snapshot[16];
+	long frees_before = iwx_test_frees;
+
+	memcpy(snapshot, DB_BASE(m), sizeof (snapshot));
+	m->b_rptr = rptr;
+	m->b_wptr = wptr;
+	CHECK(iwx_m_shift_right(m, 0, 0) == B_FALSE, what);
+	CHECK(m->b_rptr == rptr && m->b_wptr == wptr,
+	    "bad-window rejection must preserve pointer values");
+	CHECK(memcmp(DB_BASE(m), snapshot, sizeof (snapshot)) == 0,
+	    "bad-window rejection must preserve backing bytes");
+	CHECK(iwx_test_frees == frees_before,
+	    "bad-window rejection must preserve caller ownership");
+	m->b_rptr = saved_rptr;
+	m->b_wptr = saved_wptr;
+}
+
+static void
+test_shift_right_zero_pad_validates_length(void)
+{
+	mblk_t *m = iwx_m_alloc(64);
+	unsigned char *base;
+	unsigned char snapshot[16];
+	unsigned char *saved_rptr, *saved_wptr;
+	long frees_before;
+
+	CHECK(iwx_m_shift_right(NULL, SIZE_MAX, 0) == B_FALSE,
+	    "NULL mblk must be rejected for a zero-pad request");
+	CHECK(m != NULL, "alloc zero-pad length test");
+	if (m == NULL)
+		return;
+
+	base = DB_BASE(m);
+	m->b_rptr = base;
+	m->b_wptr = base + sizeof (snapshot);
+	memset(base, 0x5A, sizeof (snapshot));
+	memcpy(snapshot, base, sizeof (snapshot));
+	saved_rptr = m->b_rptr;
+	saved_wptr = m->b_wptr;
+	frees_before = iwx_test_frees;
+
+	CHECK(iwx_m_shift_right(m, sizeof (snapshot), 0) == B_TRUE,
+	    "zero-pad exact readable length is a valid no-op");
+	CHECK(iwx_m_shift_right(m, sizeof (snapshot) + 1, 0) == B_FALSE,
+	    "zero-pad source one byte past the readable window is rejected");
+	CHECK(iwx_m_shift_right(m, SIZE_MAX, 0) == B_FALSE,
+	    "zero-pad SIZE_MAX source length is rejected");
+	CHECK(iwx_m_shift_right(m, 0, 0) == B_TRUE,
+	    "empty zero-pad request remains a valid no-op");
+	CHECK(m->b_rptr == saved_rptr && m->b_wptr == saved_wptr,
+	    "zero-pad validation must preserve the message window");
+	CHECK(memcmp(base, snapshot, sizeof (snapshot)) == 0,
+	    "zero-pad validation must preserve backing bytes");
+	CHECK(iwx_test_frees == frees_before,
+	    "zero-pad validation must preserve caller ownership");
+	iwx_m_free(m);
+}
+
+static void
+test_shift_right_rejects_malformed_window(void)
+{
+	mblk_t *m = iwx_m_alloc(64);
+	uintptr_t base_addr, limit_addr;
+	unsigned char *saved_limit;
+
+	CHECK(m != NULL, "alloc");
+	if (m == NULL)
+		return;
+
+	base_addr = (uintptr_t)DB_BASE(m);
+	limit_addr = (uintptr_t)DB_LIM(m);
+	CHECK(base_addr != 0 && limit_addr != UINTPTR_MAX &&
+	    limit_addr > base_addr && limit_addr - base_addr >= 32,
+	    "test allocation addresses must permit adjacent invalid sentinels");
+	if (base_addr == 0 || limit_addr == UINTPTR_MAX ||
+	    limit_addr <= base_addr || limit_addr - base_addr < 32) {
+		iwx_m_free(m);
+		return;
+	}
+	memset(DB_BASE(m), 0xA5, 16);
+
+	check_shift_rejects_bad_window(m,
+	    (unsigned char *)(base_addr - 1),
+	    (unsigned char *)(base_addr + 8),
+	    "read pointer below db_base must be rejected");
+	check_shift_rejects_bad_window(m,
+	    (unsigned char *)(limit_addr + 1),
+	    (unsigned char *)(limit_addr + 1),
+	    "read pointer above db_lim must be rejected");
+	check_shift_rejects_bad_window(m,
+	    (unsigned char *)(base_addr + 16),
+	    (unsigned char *)(base_addr + 8),
+	    "write pointer before read pointer must be rejected");
+	check_shift_rejects_bad_window(m,
+	    (unsigned char *)base_addr,
+	    (unsigned char *)(limit_addr + 1),
+	    "write pointer beyond db_lim must be rejected");
+
+	saved_limit = DB_LIM(m);
+	DB_LIM(m) = (unsigned char *)(base_addr - 1);
+	check_shift_rejects_bad_window(m, DB_BASE(m),
+	    (unsigned char *)(base_addr + 8),
+	    "db_lim below db_base must be rejected");
+	DB_LIM(m) = saved_limit;
+
+	iwx_m_free(m);
+}
+
+/*
  * if_iwx.c:10882 / :10927 -- "(struct iwx_rx_packet *)(m0->m_data + offset)"
  * walks several firmware responses packed into one RX buffer, where offset
  * advances by a length the device reported.
@@ -535,6 +654,8 @@
 	test_free_honours_refcount();
 	test_shift_right_moves_header_and_length();
 	test_shift_right_rejects_overflow();
+	test_shift_right_rejects_malformed_window();
+	test_shift_right_zero_pad_validates_length();
 	test_at_bounds_checks_offset();
 	test_no_leaks();
 
