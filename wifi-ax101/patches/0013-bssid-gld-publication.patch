+/*
+ * The dedicated worker is the only caller of the GLDv3 wifi metadata APIs.
+ * mac_pdata_update() returns an error; mac_tx_update() is void in the pinned
+ * illumos ABI. A generation is committed only after both calls have returned.
+ */
+static void
+iwm_gld_publisher(void *arg)
+{
+	struct iwm_gld *g = arg;
+
+	for (;;) {
+		wifi_data_t snapshot;
+		uint64_t generation;
+		int err;
+
+		mutex_enter(&g->g_pub_lock);
+		while (g->g_pub_state != PUBLISHER_STOPPING &&
+		    (g->g_pub_pending_generation ==
+		    g->g_pub_published_generation ||
+		    g->g_pub_failed_generation ==
+		    g->g_pub_pending_generation))
+			cv_wait(&g->g_pub_cv, &g->g_pub_lock);
+		if (g->g_pub_state == PUBLISHER_STOPPING &&
+		    g->g_pub_pending_generation ==
+		    g->g_pub_published_generation) {
+			g->g_pub_state = PUBLISHER_STOPPED;
+			cv_broadcast(&g->g_pub_cv);
+			mutex_exit(&g->g_pub_lock);
+			thread_exit();
+		}
+		/* STOPPING is entered only after a successful publisher drain. */
+		ASSERT(g->g_pub_state != PUBLISHER_STOPPING);
+		generation = g->g_pub_pending_generation;
+		snapshot = g->g_pub_pending_snapshot;
+		mutex_exit(&g->g_pub_lock);
+
+		/* No n80211_giant or driver-owned lock is held across MAC calls. */
+		err = mac_pdata_update(g->g_mh, &snapshot, sizeof (snapshot));
+		if (err == 0)
+			mac_tx_update(g->g_mh);
+
+		mutex_enter(&g->g_pub_lock);
+		if (err == 0) {
+			ASSERT(generation >= g->g_pub_published_generation);
+			g->g_pub_published_generation = generation;
+			if (g->g_pub_failed_generation <= generation)
+				g->g_pub_failed_generation = 0;
+			if (generation == g->g_pub_pending_generation)
+				g->g_pub_error = 0;
+		} else {
+			g->g_pub_failed_generation = generation;
+			g->g_pub_error = err;
+		}
+		cv_broadcast(&g->g_pub_cv);
+		mutex_exit(&g->g_pub_lock);
+	}
+}
+
+/* Callback dispatch has been disabled and n80211_dispatch_refs drained. */
+static int
+iwm_gld_publisher_drain(struct iwm_gld *g)
+{
+	uint64_t target;
+	int err;
+
+	mutex_enter(&g->g_pub_lock);
+	if (g->g_pub_state == PUBLISHER_RUNNING)
+		g->g_pub_state = PUBLISHER_QUIESCING;
+	if (g->g_pub_state == PUBLISHER_QUIESCING)
+		g->g_pub_state = PUBLISHER_DRAINING;
+	ASSERT(g->g_pub_state == PUBLISHER_DRAINING);
+	target = g->g_pub_pending_generation;
+	/* An older failed generation must not abort a newer pending target. */
+	while (g->g_pub_published_generation < target &&
+	    g->g_pub_failed_generation != target)
+		cv_wait(&g->g_pub_cv, &g->g_pub_lock);
+	err = (g->g_pub_published_generation >= target) ? 0 :
+	    (g->g_pub_error != 0 ? g->g_pub_error : EIO);
+	mutex_exit(&g->g_pub_lock);
+	return (err);
+}
+
+static void
+iwm_gld_publisher_resume(struct iwm_gld *g)
+{
+	mutex_enter(&g->g_pub_lock);
+	ASSERT(g->g_pub_state == PUBLISHER_DRAINING ||
+	    g->g_pub_state == PUBLISHER_QUIESCING);
+	g->g_pub_failed_generation = 0;
+	g->g_pub_error = 0;
+	if (g->g_pub_overflow)
+		g->g_pub_state = PUBLISHER_QUIESCING;
+	else
+		g->g_pub_state = PUBLISHER_RUNNING;
+	cv_broadcast(&g->g_pub_cv);
+	mutex_exit(&g->g_pub_lock);
+}
