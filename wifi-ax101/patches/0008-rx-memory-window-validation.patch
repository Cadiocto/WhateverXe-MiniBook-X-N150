+/*
+ * Malformed mblk windows must be rejected before pointer subtraction. The
+ * helper must be failure-atomic: no pointer, byte, or ownership changes.
+ */
 static void
+test_shift_right_rejects_malformed_window(void)
+{
+	mblk_t *m = iwx_m_alloc(32);
+	unsigned char *base;
+	unsigned char snapshot[32];
+	unsigned char *saved_r, *saved_w, *saved_limit;
+	uintptr_t b;
+	long frees_before;
+
+	CHECK(m != NULL, "alloc malformed-window test");
+	if (m == NULL)
+		return;
+	base = DB_BASE(m);
+	b = (uintptr_t)base;
+	frees_before = iwx_test_frees;
+	memset(base, 0x6D, sizeof (snapshot));
+	memcpy(snapshot, base, sizeof (snapshot));
+
+	/* b_rptr below db_base. */
+	m->b_rptr = (unsigned char *)(b - 1);
+	m->b_wptr = base + 16;
+	saved_r = m->b_rptr; saved_w = m->b_wptr;
+	CHECK(iwx_m_shift_right(m, 8, 2) == B_FALSE, "reject rptr below db_base");
+	CHECK(m->b_rptr == saved_r && m->b_wptr == saved_w, "below-base refusal preserves pointers");
+
+	/* b_rptr beyond db_lim. */
+	m->b_rptr = (unsigned char *)(b + 33);
+	m->b_wptr = (unsigned char *)(b + 33);
+	saved_r = m->b_rptr; saved_w = m->b_wptr;
+	CHECK(iwx_m_shift_right(m, 0, 2) == B_FALSE, "reject rptr beyond db_lim");
+	CHECK(m->b_rptr == saved_r && m->b_wptr == saved_w, "beyond-limit refusal preserves pointers");
+
+	/* b_wptr before b_rptr. */
+	m->b_rptr = base + 8;
+	m->b_wptr = base + 7;
+	saved_r = m->b_rptr; saved_w = m->b_wptr;
+	CHECK(iwx_m_shift_right(m, 1, 2) == B_FALSE, "reject wptr before rptr");
+	CHECK(m->b_rptr == saved_r && m->b_wptr == saved_w, "reversed-window refusal preserves pointers");
+
+	/* b_wptr beyond db_lim. */
+	m->b_rptr = base;
+	m->b_wptr = (unsigned char *)(b + 33);
+	saved_r = m->b_rptr; saved_w = m->b_wptr;
+	CHECK(iwx_m_shift_right(m, 8, 2) == B_FALSE, "reject wptr beyond db_lim");
+	CHECK(m->b_rptr == saved_r && m->b_wptr == saved_w, "oversized-window refusal preserves pointers");
+
+	/* An inverted backing-cluster range is invalid even if the data window is plausible. */
+	m->b_rptr = base;
+	m->b_wptr = base + 16;
+	saved_r = m->b_rptr; saved_w = m->b_wptr;
+	saved_limit = m->b_datap->db_lim;
+	m->b_datap->db_lim = (unsigned char *)(b - 1);
+	CHECK(iwx_m_shift_right(m, 8, 2) == B_FALSE, "reject db_lim below db_base");
+	CHECK(m->b_rptr == saved_r && m->b_wptr == saved_w, "inverted-cluster refusal preserves pointers");
+	m->b_datap->db_lim = saved_limit;
+
+	/* Oversized lengths must be rejected without addition overflow. */
+	CHECK(iwx_m_shift_right(m, SIZE_MAX, 2) == B_FALSE, "reject SIZE_MAX header length");
+	CHECK(iwx_m_shift_right(m, 8, SIZE_MAX) == B_FALSE, "reject SIZE_MAX padding length");
+	CHECK(m->b_rptr == base && m->b_wptr == base + 16, "oversized-length refusals preserve pointers");
+	CHECK(memcmp(base, snapshot, sizeof (snapshot)) == 0, "all malformed-window refusals preserve bytes");
+	CHECK(iwx_test_frees == frees_before, "helper does not consume malformed message");
+	iwx_m_free(m);
+}
