diff --git a/src/ports/wifi/iwx/iwx_mbuf.c b/src/ports/wifi/iwx/iwx_mbuf.c
--- a/src/ports/wifi/iwx/iwx_mbuf.c
+++ b/src/ports/wifi/iwx/iwx_mbuf.c
@@ -180,29 +180,29 @@
 		return (B_TRUE);
 
 	/*
-	 * OpenBSD's memmove(m->m_data + 2, m->m_data, hdrlen) writes hdrlen
-	 * bytes starting 2 past the read pointer, i.e. it needs len + n bytes of
-	 * cluster from b_rptr. On OpenBSD the RX cluster is oversized and that
-	 * slack is implicit; allocb() does not promise it at the same offset, so
-	 * check it. Overflow-safe form: compare against the remaining span
-	 * rather than computing src + len + n.
+	 * The RX descriptor's MPDU length includes the alignment pad after
+	 * the header. The caller moves the header over that pad, then trims
+	 * the pad from the head with iwx_m_adj(m, n). Do not extend b_wptr:
+	 * that would cancel the head trim and expose n bytes beyond the
+	 * received MPDU as payload.
+	 *
+	 * The destination must fit both the backing cluster and the received
+	 * window. The second check also proves that all n pad bytes are
+	 * actually present in the received MPDU, not merely allocated.
 	 */
 	if (len > (size_t)(DB_LIM(m) - src))
 		return (B_FALSE);
 	if (n > (size_t)(DB_LIM(m) - src) - len)
 		return (B_FALSE);
 
-	/* The source bytes must actually be readable, not merely allocated. */
+	/* The source header and the following pad must both be readable. */
 	if (len > (size_t)(m->b_wptr - src))
 		return (B_FALSE);
+	if (n > (size_t)(m->b_wptr - src) - len)
+		return (B_FALSE);
 
+	/* b_wptr stays put; the caller's iwx_m_adj(m, n) removes the pad. */
 	memmove(src + n, src, len);
-	/*
-	 * The frame is now n bytes longer. Without this the caller's following
-	 * m_adj(m, n) (if_iwx.c:5265) trims the pad AND n bytes of real payload
-	 * off the tail-derived length, and the corruption is silent.
-	 */
-	m->b_wptr += n;
 	return (B_TRUE);
 }
 
diff --git a/src/ports/wifi/iwx/iwx_mbuf.h b/src/ports/wifi/iwx/iwx_mbuf.h
