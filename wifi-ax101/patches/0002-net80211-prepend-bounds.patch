diff --git a/src/ports/wifi/net80211/n80211_mbuf.c b/src/ports/wifi/net80211/n80211_mbuf.c
--- a/src/ports/wifi/net80211/n80211_mbuf.c
+++ b/src/ports/wifi/net80211/n80211_mbuf.c
@@ -35,6 +35,7 @@
 #include <sys/sunddi.h>
 #else
 #include "iwx_mbuf_test_stubs.h"
+#include <stdint.h>
 #include <string.h>
 #endif
 
@@ -114,21 +115,37 @@
 mblk_t *
 n80211_m_prepend(mblk_t *m, int len, int how)
 {
+	uintptr_t base, lim, rptr, wptr;
+	size_t need;
+
 	(void) how;
 	if (m == NULL || len < 0)
 		return (NULL);
-	if (m->b_rptr - (size_t)len < DB_BASE(m)) {
-		/* not enough headroom -- OpenBSD would alloc a new head; on the
-		 * mgmt/EAPOL paths this cannot happen because the frame was
-		 * allocated with slop, so a shortfall is a real error. */
+
+	/*
+	 * Validate integer address values before forming a pointer before
+	 * DB_BASE. Subtracting len from b_rptr first (the old check) forms an
+	 * out-of-object pointer when headroom is insufficient; that is
+	 * undefined behavior even though the pointer is only compared.
+	 */
+	base = (uintptr_t)DB_BASE(m);
+	lim = (uintptr_t)DB_LIM(m);
+	rptr = (uintptr_t)m->b_rptr;
+	wptr = (uintptr_t)m->b_wptr;
+	need = (size_t)len;
+
+	if (lim < base || rptr < base || rptr > lim ||
+	    wptr < rptr || wptr > lim || need > (size_t)(rptr - base)) {
+		/* Invalid window or insufficient headroom: consume the frame. */
 		freemsg(m);
 		return (NULL);
 	}
-	m->b_rptr -= (size_t)len;
-	/* the new bytes are part of the frame; keep the write window covering
-	 * at least the prepended region so mtod()+len is writable. */
-	if (m->b_wptr < m->b_rptr + (size_t)len)
-		m->b_wptr = m->b_rptr + (size_t)len;
+
+	/*
+	 * b_wptr remains unchanged. Moving b_rptr back by need expands the
+	 * derived readable window by exactly need bytes.
+	 */
+	m->b_rptr = (unsigned char *)(rptr - need);
 	return (m);
 }
 
