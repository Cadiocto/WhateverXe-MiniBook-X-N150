+/* Interrupt-safe BSSID snapshot; caller holds n80211_giant. */
+void
+iwm_il_get_bssid(void *arg, uint8_t *bssid)
+{
+	struct iwm_softc *sc = arg;
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211_node *ni = ic->ic_bss;
+
+	if (ic->ic_state == IEEE80211_S_INIT ||
+	    ic->ic_state == IEEE80211_S_SCAN || ni == NULL) {
+		if (ic->ic_flags & IEEE80211_F_DESBSSID)
+			IEEE80211_ADDR_COPY(bssid, ic->ic_des_bssid);
+		else
+			bzero(bssid, IEEE80211_ADDR_LEN);
+	} else {
+		IEEE80211_ADDR_COPY(bssid, ni->ni_bssid);
+	}
+}
