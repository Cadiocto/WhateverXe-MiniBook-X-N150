 }
 
+static void
+n80211_link_deferred(void *arg)
+{
+	(void) arg;
+	if (!n80211_gld_enabled || n80211_deferred_link_pending == -1)
+		return;
+	n80211_link_pending = n80211_deferred_link_pending;
+	n80211_link_mh = n80211_deferred_link_mh;
+	n80211_deferred_link_pending = -1;
+	n80211_deferred_link_mh = NULL;
+}
+
 void
 n80211_systq_init(void)
 {
 	n80211_taskq_init(systq, "n80211_systq");
+	task_set(&n80211_link_deferred_task, n80211_link_deferred, NULL);
 }
