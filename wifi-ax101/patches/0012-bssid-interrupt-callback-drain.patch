+void
+n80211_gld_callbacks_enable(mblk_t *(*rx)(void *, mblk_t *),
+    void (*link)(void *, int), void (*bssid)(void *, int), void *arg)
+{
+	mutex_enter(&n80211_giant);
+	n80211_rx_xlate = rx;
+	n80211_link_hook = link;
+	n80211_bssid_hook = bssid;
+	n80211_xlate_arg = arg;
+	n80211_gld_enabled = 1;
+	mutex_exit(&n80211_giant);
+}
+
+void
+n80211_gld_callbacks_disable(void)
+{
+	mblk_t *chain;
+
+	mutex_enter(&n80211_giant);
+	n80211_gld_enabled = 0;
+	n80211_rx_xlate = NULL;
+	n80211_link_hook = NULL;
+	n80211_bssid_hook = NULL;
+	n80211_xlate_arg = NULL;
+	n80211_link_pending = -1;
+	n80211_deferred_link_pending = -1;
+	n80211_deferred_link_mh = NULL;
+	(void) task_del(systq, &n80211_link_deferred_task);
+	chain = n80211_rx_head;
+	n80211_rx_head = n80211_rx_tail = NULL;
+	while (n80211_dispatch_refs != 0)
+		cv_wait(&n80211_dispatch_cv, &n80211_giant);
+	mutex_exit(&n80211_giant);
+
+	if (chain != NULL)
+		freemsgchain(chain);
+}
+
+/* Called only after mac_unregister succeeds and dispatch is quiescent. */
+void
+n80211_gld_callbacks_forget(void)
+{
+	mutex_enter(&n80211_giant);
+	ASSERT(!n80211_gld_enabled);
+	ASSERT(n80211_dispatch_refs == 0);
+	n80211_rx_mh = NULL;
+	n80211_link_mh = NULL;
+	n80211_link_pending = -1;
+	n80211_deferred_link_pending = -1;
+	n80211_deferred_link_mh = NULL;
+	mutex_exit(&n80211_giant);
+}
 
