diff --git a/usr/src/uts/i86pc/boot/boot_fb.c b/usr/src/uts/i86pc/boot/boot_fb.c
--- a/usr/src/uts/i86pc/boot/boot_fb.c
+++ b/usr/src/uts/i86pc/boot/boot_fb.c
@@
+#include <sys/rotfb.h>
@@
 void
 boot_fb_shadow_init(bootops_t *bops)
 {
 	if (boot_console_type(NULL) != CONS_FRAMEBUFFER)
 		return;
+	if (rotfb_info.configured &&
+	    rotfb_boot_shadow_init(bops, &fb_info) == 0)
+		return;
@@
 void
 boot_fb_init(int console)
 {
@@
-	fb_info.fb = (uint8_t *)(uintptr_t)fb_info.paddr;
+	if (rotfb_info.configured && rotfb_info.logical_fb != NULL &&
+	    rotfb_boot_init(&fb_info,
+	    (uint8_t *)(uintptr_t)rotfb_info.physical_paddr) == 0) {
+		(void) rotfb_boot_import(&fb_info);
+		fb_info.fb = rotfb_info.logical_fb;
+	} else {
+		fb_info.fb = (uint8_t *)(uintptr_t)fb_info.paddr;
+	}
