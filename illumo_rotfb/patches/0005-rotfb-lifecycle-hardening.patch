-	gfxp_map_devmem(dhp, console->fb.paddr, length, &dev_attr);
+	if (console->fb.paddr > (uint64_t)-1 - (uint64_t)off)
+		return (ENXIO);
+	maddr = console->fb.paddr + (uint64_t)off;
+	if (maddr > (uint64_t)-1 - (uint64_t)length)
