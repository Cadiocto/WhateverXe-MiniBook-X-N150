@@ -29,6 +29,7 @@
 #include <sys/kd.h>
 #include <sys/sunddi.h>
 #include <sys/rgb.h>
+#include <sys/errno.h>
 #include <sys/rotfb.h>
 #include <sys/gfx_private.h>
 #include "gfxp_fb.h"
@@ -147,17 +148,24 @@
 	if (softc == NULL || softc->console == NULL)
 		return (DDI_SUCCESS);
 
 	if (softc->console->fb.fb_size != 0) {
