+	/* A rotated shadow surface is not physically contiguous in this layout. */
+	if (rotfb_info.configured)
+		return (ENOTSUP);
+
+	if (off < 0 || console->fb.fb_size == 0 ||
+	    console->fb.fb_size > (uint64_t)((size_t)-1)) {
+		return (ENXIO);
+	}
+
+	if ((uint64_t)off >= console->fb.fb_size) {
 		cmn_err(CE_WARN, "bitmap: Can't map offset 0x%llx", off);
 		return (ENXIO);
 	}
 
-	if (off + len > console->fb.fb_size)
-		length = console->fb.fb_size - off;
-	else
-		length = len;
+	remaining = (size_t)(console->fb.fb_size - (uint64_t)off);
