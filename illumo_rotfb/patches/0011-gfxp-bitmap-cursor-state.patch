+static boolean_t
+bitmap_cursor_geometry(union gfx_console *console,
+    rotfb_vis_cursor_geometry_t *geometry)
+{
+	if (console == NULL || geometry == NULL ||
+	    console->fb.fb == NULL || console->fb.shadow_fb == NULL)
+		return (B_FALSE);
+	geometry->screen_width = console->fb.screen.x;
+	geometry->screen_height = console->fb.screen.y;
+	geometry->terminal_origin_x = console->fb.terminal_origin.x;
+	geometry->terminal_origin_y = console->fb.terminal_origin.y;
+	geometry->terminal_width = console->fb.terminal.x;
+	geometry->terminal_height = console->fb.terminal.y;
+	geometry->font_width = console->fb.font_width;
+	geometry->font_height = console->fb.font_height;
+	geometry->bpp = console->fb.bpp;
+	geometry->pitch = console->fb.pitch;
+	geometry->fb_size = console->fb.fb_size;
+	return (B_TRUE);
+}
+
+static boolean_t
+bitmap_cursor_valid(union gfx_console *console, struct vis_conscursor *ca)
+{
+	rotfb_vis_cursor_geometry_t geometry;
+
+	if (ca == NULL || !bitmap_cursor_geometry(console, &geometry))
+		return (B_FALSE);
+	return (rotfb_vis_cursor_validate(&geometry, ca->col, ca->row,
+	    ca->width, ca->height) ? B_TRUE : B_FALSE);
+}
+
+static boolean_t
+bitmap_cursor_update(union gfx_console *console, struct vis_conscursor *ca)
+{
+	rotfb_vis_cursor_geometry_t geometry;
+
+	if (ca == NULL || !bitmap_cursor_geometry(console, &geometry))
+		return (B_FALSE);
+	return (rotfb_vis_cursor_update(&geometry, ca->col, ca->row,
+	    ca->width, ca->height, &console->fb.cursor.pos.x,
+	    &console->fb.cursor.pos.y, &console->fb.cursor.origin.x,
+	    &console->fb.cursor.origin.y) ? B_TRUE : B_FALSE);
+}
