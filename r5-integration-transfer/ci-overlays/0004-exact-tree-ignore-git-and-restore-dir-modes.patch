+def read_manifest(path: Path):
+    expected = {}
+    lines = path.read_text().splitlines()
+    if not lines or lines[0] != HEADER:
+        raise SystemExit('bad manifest header')
+    for line_no, line in enumerate(lines[1:], 2):
+        fields = line.split('\t', 4)
+        if len(fields) != 5:
+            raise SystemExit(f'malformed manifest line {line_no}')
+        typ, mode, size, digest, rel = fields
+        pp = PurePosixPath(rel)
+        if pp.is_absolute() or '..' in pp.parts or rel in ('', '.', '.git') or rel.startswith('.git/'):
+            raise SystemExit(f'unsafe or administrative manifest path at line {line_no}: {rel}')
+        if rel in expected:
+            raise SystemExit(f'duplicate manifest path at line {line_no}: {rel}')
+        if typ not in ('dir', 'file', 'link'):
+            raise SystemExit(f'unknown manifest type at line {line_no}: {typ}')
+        if len(mode) != 4 or any(ch not in '01234567' for ch in mode):
+            raise SystemExit(f'invalid mode at line {line_no}: {mode}')
+        expected[rel] = (typ, mode, size, digest)
+    return expected
+
+
+def restore_directory_modes(root: Path, expected):
+    """Git trees do not encode directory modes; restore them from the source manifest."""
+    restored = 0
+    for rel, record in expected.items():
+        typ, mode, _size, _digest = record
+        if typ != 'dir':
+            continue
+        target = root.joinpath(*PurePosixPath(rel).parts)
+        try:
+            st = target.lstat()
+        except FileNotFoundError:
+            continue  # Reported by the normal missing-path comparison below.
+        if not stat.S_ISDIR(st.st_mode):
+            continue  # Reported as a type/content difference below.
+        os.chmod(target, int(mode, 8))
+        actual_mode = f'{stat.S_IMODE(target.lstat().st_mode):04o}'
+        if actual_mode != mode:
+            raise RuntimeError(f'cannot restore directory mode {rel}: expected {mode}, got {actual_mode}')
+        restored += 1
+    return restored
+
 
